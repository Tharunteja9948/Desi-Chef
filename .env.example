# ==============================================================================
# DESI Chef Environment Configuration
# ==============================================================================

# Security
SECRET_KEY=django-insecure-ai-chef-production-grade-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Database Configuration (Set DB_ENGINE=mysql to enable MySQL)
DB_ENGINE=sqlite3
DB_NAME=ai_chef_db
DB_USER=root
DB_PASSWORD=your_secure_password
DB_HOST=127.0.0.1
DB_PORT=3306

# CORS Settings
CORS_ALLOW_ALL_ORIGINS=True
