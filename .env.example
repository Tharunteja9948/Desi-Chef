# ==============================================================================
# DesiChef - Environment Configuration
# ==============================================================================

# Security Settings
# Generate a secure key in production (e.g., using: python -c 'import secrets; print(secrets.token_urlsafe(50))')
SECRET_KEY=django-insecure-change-this-in-production-use-a-strong-random-key
DEBUG=False
ALLOWED_HOSTS=127.0.0.1,localhost,.onrender.com

# Database Configuration
# Options: 'sqlite3', 'postgresql', 'mysql'
# If DATABASE_URL is set (e.g., on Render), it takes precedence automatically.
DB_ENGINE=sqlite3
# DATABASE_URL=postgresql://user:password@hostname:5432/desi_chef_db

# (Optional: Only if DB_ENGINE=mysql)
# DB_NAME=desi_chef_db
# DB_USER=root
# DB_PASSWORD=your_password
# DB_HOST=127.0.0.1
# DB_PORT=3306

# CORS & CSRF Trusted Origins
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://desi-chef.onrender.com,http://localhost:8000,http://127.0.0.1:8000
CSRF_TRUSTED_ORIGINS=https://desi-chef.onrender.com,http://localhost:8000,http://127.0.0.1:8000

# SSL & Security Headers (Recommended for Production HTTPS)
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
